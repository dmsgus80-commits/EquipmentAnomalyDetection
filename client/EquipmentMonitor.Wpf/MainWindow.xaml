<Window x:Class="EquipmentMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Equipment Monitor"
        Height="700"
        Width="900"
        MinHeight="560"
        MinWidth="760">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14" BorderBrush="#D9DEE5" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="설비 모니터링" FontSize="25" FontWeight="Bold"/>
                    <TextBlock x:Name="LastUpdatedText"
                               Text="마지막 갱신: 대기 중"
                               Foreground="DimGray"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusText"
                               Text="상태 확인 중"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="ConnectionText"
                               Text="서버 연결 확인 중"
                               Foreground="DimGray"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                    <TextBlock x:Name="UnacknowledgedHeaderText"
                               Text="미확인 알림: 0"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="20,12,20,20">
            <TabItem Header="현황">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="현재 센서값" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2">
                            <TextBlock x:Name="AirTemperatureText" FontSize="17" Margin="0,5"/>
                            <TextBlock x:Name="ProcessTemperatureText" FontSize="17" Margin="0,5"/>
                            <TextBlock x:Name="RpmText" FontSize="17" Margin="0,5"/>
                            <TextBlock x:Name="TorqueText" FontSize="17" Margin="0,5"/>
                            <TextBlock x:Name="ToolWearText" FontSize="17" Margin="0,5"/>
                            <TextBlock x:Name="FailureProbabilityText" FontSize="17" Margin="0,5"/>
                            <TextBlock x:Name="FailureTypeProbabilityText" FontSize="17" Margin="0,5"/>
                        </UniformGrid>

                        <TextBlock Text="온도 추이" FontSize="20" FontWeight="Bold" Margin="0,24,0,10"/>
                        <lvc:CartesianChart x:Name="TemperatureChart" Height="250"/>
                        <TextBlock x:Name="AverageTemperatureText" FontSize="16" Margin="0,14,0,0"/>
                        <TextBlock x:Name="AverageTorqueText" FontSize="16" Margin="0,5,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="알림"/>
                        <TextBlock x:Name="AlertTabCountText" Text=" (0)" FontWeight="Bold"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Padding="16,10" Margin="0,0,10,0" BorderBrush="#D9DEE5" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="미확인" FontWeight="Bold"/>
                                <TextBlock x:Name="UnacknowledgedCountText" Text="0" FontSize="23"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="16,10" Margin="0,0,10,0" BorderBrush="#D9DEE5" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="확인됨" FontWeight="Bold"/>
                                <TextBlock x:Name="AcknowledgedCountText" Text="0" FontSize="23"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="16,10" BorderBrush="#D9DEE5" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="조치 완료" FontWeight="Bold"/>
                                <TextBlock x:Name="ResolvedCountText" Text="0" FontSize="23"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="최근 알림 (최대 100건)" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="AnomalyCountText" Margin="18,5,0,0" Foreground="DimGray"/>
                        </StackPanel>
                        <ComboBox x:Name="AlertStatusFilter"
                                  Grid.Column="1"
                                  Width="130"
                                  SelectedIndex="0"
                                  ToolTip="최근 알림의 상태로 필터링">
                            <ComboBoxItem Content="전체" Tag="ALL"/>
                            <ComboBoxItem Content="미확인" Tag="UNACKNOWLEDGED"/>
                            <ComboBoxItem Content="확인됨" Tag="ACKNOWLEDGED"/>
                            <ComboBoxItem Content="조치 완료" Tag="RESOLVED"/>
                        </ComboBox>
                    </Grid>

                    <DataGrid x:Name="HistoryGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시간"
                                                Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                Width="*"/>
                            <DataGridTextColumn Header="고장 유형"
                                                Binding="{Binding FailureType}"
                                                Width="*"/>
                            <DataGridTextColumn Header="고장 확률"
                                                Binding="{Binding FailureProbability, StringFormat=P1}"
                                                Width="*"/>
                            <DataGridTextColumn Header="상태"
                                                Binding="{Binding StatusText}"
                                                Width="110"/>
                            <DataGridTemplateColumn Header="확인" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="확인"
                                                Click="AcknowledgeButton_Click"
                                                IsEnabled="{Binding CanAcknowledge}"
                                                Padding="8,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="조치 완료" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="조치 완료"
                                                Click="ResolveButton_Click"
                                                IsEnabled="{Binding CanResolve}"
                                                Padding="8,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="분석">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock x:Name="LatestFailureTypeText" FontSize="17" Margin="0,0,0,5"/>
                        <TextBlock x:Name="AnomalyRateText" FontSize="17" Margin="0,0,0,5"/>
                        <TextBlock x:Name="FailureTypeCountText" FontSize="17" TextWrapping="Wrap"/>

                        <TextBlock Text="알림 상태 분포" FontSize="20" FontWeight="Bold" Margin="0,24,0,10"/>
                        <lvc:CartesianChart Height="240"
                                            Series="{Binding AlarmStatusSeries, RelativeSource={RelativeSource AncestorType=Window}}"
                                            XAxes="{Binding AlarmStatusXAxes, RelativeSource={RelativeSource AncestorType=Window}}"/>

                        <TextBlock Text="고장 유형 분포 (최근 100건)" FontSize="20" FontWeight="Bold" Margin="0,24,0,10"/>
                        <lvc:CartesianChart x:Name="FailureTypeChart" Height="240"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
